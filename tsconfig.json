{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": false,
    "incremental": true,
    "declaration": true,
    "types": ["node"]
  }
}
